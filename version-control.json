{
  "project": "r2share",
  "repository": "https://github.com/riverho/r2share",
  "branch": "docs-release-prep",
  "release": {
    "version": "0.2.0",
    "tag": "v0.2.0",
    "status": "prep",
    "note": "Docs and version bump stacked on folder-sync (a04d2e6). Not a published release; awaiting user approval before push/tag/release.",
    "date": "2026-10-07",
    "timezone": "Asia/Shanghai",
    "basedOn": {
      "branch": "folder-sync",
      "commit": "a04d2e6fc8c045ccda03ffd472fdc22b854b2c29"
    }
  },
  "build": {
    "linux": "npm run build",
    "windows": "npm run desktop:build:win",
    "artifacts": {
      "linux": [
        "src-tauri/target/release/r2share",
        "src-tauri/target/release/r2share-cli",
        "src-tauri/target/release/bundle/deb/r2share_0.2.0_amd64.deb"
      ],
      "windows": [
        "src-tauri/target/release/r2share.exe",
        "src-tauri/target/release/bundle/nsis/r2share_0.2.0_x64-setup.exe",
        "src-tauri/target/release/bundle/msi/r2share_0.2.0_x64_en-US.msi"
      ]
    }
  },
  "sourcePolicy": {
    "tracked": [
      "README.md",
      "index.html",
      "package.json",
      "package-lock.json",
      "src-tauri/Cargo.toml",
      "src-tauri/Cargo.lock",
      "src-tauri/build.rs",
      "src-tauri/tauri.conf.json",
      "src-tauri/capabilities/",
      "src-tauri/icons/",
      "src-tauri/src/",
      "version-control.json",
      ".gitignore"
    ],
    "ignored": [
      "node_modules/",
      "src-tauri/target/",
      "src-tauri/gen/",
      "internal markdown docs except README.md",
      "agent memory and guardrail files",
      "local setup helpers",
      "env/credential dumps",
      "smoke-test and screenshot scratch under repo"
    ]
  }
}
